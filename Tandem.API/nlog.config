<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog decides WHERE logs go and HOW each line looks.
  WHICH levels are written is decided in appsettings.json / appsettings.{Environment}.json ("Logging" section).
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="lineLayout"
            value="${longdate} | ${level:uppercase=true:padding=-5} | ${scopeproperty:CorrelationId:whenEmpty=-} | ${logger:shortName=true} | ${message}${onexception:${newline}${exception:format=tostring}}" />

  <targets>
    <!-- One file per day, in Tandem.API/logs -->
    <target xsi:type="File" name="file"
            fileName="${aspnet-appbasepath}/logs/tandem-${shortdate}.log"
            layout="${lineLayout}"
            encoding="utf-8" />

    <target xsi:type="ColoredConsole" name="console" layout="${lineLayout}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="file,console" />
  </rules>
</nlog>
